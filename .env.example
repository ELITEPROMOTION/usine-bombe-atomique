# ============================================================
# Usine Bombe Atomique - Template variables d'environnement
# Copier vers .env et remplir les valeurs reelles.
# ============================================================

APP_NAME=Usine Bombe Atomique
APP_VERSION=0.1.0
ENV=development
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=uba
POSTGRES_USER=uba
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-16

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT - generer avec: openssl rand -hex 32
JWT_SECRET=changeme-32-bytes-hex-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Anthropic Claude - a fournir pour runtime plateforme
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_TIMEOUT=900

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Services externes (optionnels V2+)
SONARQUBE_URL=
SONARQUBE_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=

# V4.3 : Vault + SonarQube self-hosted
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=uba-dev-root
VAULT_ROOT_TOKEN=uba-dev-root
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=

# ============================================================
# V9 — Auth & Security
# ============================================================
# Phase 9J — JWT admin (>=32 chars, generer: openssl rand -hex 32)
JWT_ADMIN_SECRET=
# Phase 9N — Token legacy admin (stopgap, fallback si JWT non configure)
UBA_ADMIN_TOKEN=
# Phase 9M-bis — JWT client separe du JWT admin (>=32 chars distinct)
JWT_CLIENT_SECRET=

# ============================================================
# V9 — Live gates (defaut OFF, ON uniquement en prod)
# ============================================================
# Phase 9G — Hostinger (DNS/VPS/SSL/Backup) live mode
UBA_LIVE_HOSTINGER=0
# Phase 9H — Stripe live mode
UBA_LIVE_STRIPE=0

# ============================================================
# V9 — Stripe (Phase 9H)
# ============================================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================================
# V9 — Hostinger (Phase 9G)
# ============================================================
HOSTINGER_API_KEY=
HOSTINGER_API_BASE=https://developers.hostinger.com/api

# ============================================================
# V9 — Email (Resend, transactional)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=studio@ubastudio.io
DPO_EMAIL=dpo@ubastudio.io

# ============================================================
# V9 — Observabilite (Phase 9K)
# ============================================================
# Sentry — optionnel, no-op gracieux si absent (ADR-28)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================
# V9 — Resilience kill switches (Phase 9L)
# ============================================================
# Mettre a 1 pour fail-fast immediate sur la dependance
UBA_KILL_STRIPE=0
UBA_KILL_HOSTINGER=0
UBA_KILL_ANTHROPIC=0
UBA_KILL_OPENAI=0
UBA_KILL_RESEND=0
UBA_KILL_N8N=0

# ============================================================
# V9 — Chaos engineering (Phase 9L) — JAMAIS 1 EN PROD
# ============================================================
UBA_CHAOS_ENABLED=0

# ============================================================
# V9 — n8n (Phase 9Q)
# ============================================================
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
SLACK_WEBHOOK_OPS=
SLACK_WEBHOOK_SALES=
SLACK_WEBHOOK_COMPLIANCE=

# ============================================================
# V9 — Frontend
# ============================================================
UBA_WEB_BASE=http://localhost:5173

# ============================================================
# V9 — OpenAI fallback (Phase 9D)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
