# ============================================================
# Usine Bombe Atomique - Template variables d'environnement
# Copier vers .env et remplir les valeurs reelles.
# ============================================================

APP_NAME=Usine Bombe Atomique
APP_VERSION=0.1.0
ENV=development
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=uba
POSTGRES_USER=uba
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-16

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT - generer avec: openssl rand -hex 32
JWT_SECRET=changeme-32-bytes-hex-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Anthropic Claude - a fournir pour runtime plateforme
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_TIMEOUT=900

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Services externes (optionnels V2+)
SONARQUBE_URL=
SONARQUBE_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=

# V4.3 : Vault + SonarQube self-hosted
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=uba-dev-root
VAULT_ROOT_TOKEN=uba-dev-root
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=
