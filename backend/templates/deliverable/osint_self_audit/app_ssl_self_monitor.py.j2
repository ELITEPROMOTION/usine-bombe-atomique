"""SSL self-monitor — generated by UBA V8 OSINT Self-Audit injector.

Hourly check on the application's own domain : cert expiry, weak ciphers, grade.
Pushes Prometheus metrics if PROM_PUSHGATEWAY is configured.
"""
from __future__ import annotations

import asyncio
import logging
import os
import socket
import ssl
from datetime import datetime, timezone
from typing import Any

logger = logging.getLogger("self_audit.ssl")

OWN_DOMAIN = os.getenv("OSINT_OWN_DOMAIN", "{{ own_domain | default('localhost') }}")
SSL_PORT = int(os.getenv("OSINT_OWN_SSL_PORT", "443"))


def _probe(host: str, port: int = 443, timeout: float = 8.0) -> dict[str, Any]:
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock:
            with ctx.wrap_socket(sock, server_hostname=host) as ssock:
                cert = ssock.getpeercert()
                version = ssock.version() or ""
                cipher = (ssock.cipher() or [None])[0]
        not_after = cert.get("notAfter") if cert else None
        days_left = None
        if not_after:
            try:
                dt = datetime.strptime(not_after, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
                days_left = (dt - datetime.now(timezone.utc)).days
            except ValueError:
                pass
        return {"host": host, "version": version, "cipher": cipher,
                "expires_in_days": days_left, "ok": True}
    except Exception as exc:
        return {"host": host, "ok": False, "error": str(exc)[:200]}


def assess_grade(probe: dict[str, Any]) -> str:
    if not probe.get("ok"):
        return "F"
    cipher = (probe.get("cipher") or "").upper()
    version = probe.get("version", "")
    if "SSLV2" in version.upper() or "SSLV3" in version.upper():
        return "F"
    if "TLSV1" == version.upper() or "TLSV1.1" == version.upper():
        return "D"
    if any(weak in cipher for weak in ("RC4", "DES", "EXPORT", "NULL", "MD5")):
        return "C"
    days = probe.get("expires_in_days")
    if days is not None and days < 14:
        return "C"
    if version.upper() != "TLSV1.3":
        return "B"
    return "A"


async def main() -> dict[str, Any]:
    if os.getenv("OSINT_SSL_SELF_MONITOR_ENABLED", "1") != "1":
        return {"skipped": "OSINT_SSL_SELF_MONITOR_ENABLED != 1"}
    loop = asyncio.get_event_loop()
    probe = await loop.run_in_executor(None, _probe, OWN_DOMAIN, SSL_PORT)
    grade = assess_grade(probe)
    out = {**probe, "grade": grade}
    logger.info("ssl_self_monitor: %s", out)
    return out


if __name__ == "__main__":
    print(asyncio.run(main()))
