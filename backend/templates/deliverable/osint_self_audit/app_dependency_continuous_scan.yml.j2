name: Dependency Continuous Scan

on:
  schedule:
    - cron: '17 3 * * *'   # daily 03:17 UTC
  push:
    paths:
      - 'requirements.txt'
      - 'pyproject.toml'
      - 'package.json'
      - 'Dockerfile'

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: pip-audit
        run: |
          pip install pip-audit
          pip-audit --strict --format json -r requirements.txt > pip_audit.json || true
          cat pip_audit.json | head -100 || echo "no findings"

      - name: safety check
        run: |
          pip install safety
          safety check --json --full-report -r requirements.txt > safety.json || true
          cat safety.json | head -100 || echo "no findings"

      - name: Trivy filesystem scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: fs
          severity: HIGH,CRITICAL
          format: sarif
          output: trivy-fs.sarif
          exit-code: '0'

      - name: Upload SARIF
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy-fs.sarif

      - name: Open issue on HIGH/CRITICAL
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            try {
              const audit = JSON.parse(fs.readFileSync('pip_audit.json', 'utf8'));
              if (Array.isArray(audit) && audit.length > 0) {
                await github.rest.issues.create({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  title: `[security] ${audit.length} dependency vulnerabilities`,
                  body: '```\n' + JSON.stringify(audit, null, 2).slice(0, 4000) + '\n```',
                  labels: ['security', 'dependencies']
                });
              }
            } catch (e) {
              core.warning('No pip_audit.json or no findings');
            }
