"""Self breach check — generated by UBA V8 OSINT Self-Audit injector.

Daily HIBP check for the email domain you own (configured via env var).
Disabled by default ; set OSINT_SELF_BREACH_ENABLED=1 to enable.
"""
from __future__ import annotations

import asyncio
import logging
import os
from typing import Any

import httpx

logger = logging.getLogger("self_audit.breach")

OWN_EMAIL_DOMAIN = os.getenv("OSINT_OWN_EMAIL_DOMAIN", "{{ own_email_domain | default('example.com') }}")
HIBP_API_KEY = os.getenv("HIBP_API_KEY", "")


async def check_own_breaches() -> dict[str, Any]:
    if os.getenv("OSINT_SELF_BREACH_ENABLED", "0") != "1":
        return {"skipped": "OSINT_SELF_BREACH_ENABLED != 1"}
    if not HIBP_API_KEY:
        return {"skipped": "HIBP_API_KEY not configured"}
    url = f"https://haveibeenpwned.com/api/v3/breaches?domain={OWN_EMAIL_DOMAIN}"
    headers = {"hibp-api-key": HIBP_API_KEY,
               "user-agent": "self-audit-breach-check"}
    try:
        async with httpx.AsyncClient(timeout=20.0) as client:
            r = await client.get(url, headers=headers)
        if r.status_code == 404:
            return {"domain": OWN_EMAIL_DOMAIN, "breaches": [], "count": 0}
        if r.status_code >= 400:
            return {"domain": OWN_EMAIL_DOMAIN, "error": f"hibp-{r.status_code}"}
        data = r.json()
    except Exception as exc:
        return {"domain": OWN_EMAIL_DOMAIN, "error": str(exc)[:200]}
    return {"domain": OWN_EMAIL_DOMAIN,
            "breaches": [{"name": b.get("Name"), "date": b.get("BreachDate"),
                          "data_classes": b.get("DataClasses", [])} for b in data],
            "count": len(data)}


if __name__ == "__main__":
    out = asyncio.run(check_own_breaches())
    logger.info("breach check: %s", out)
    print(out)
