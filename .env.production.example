# .env.production - template a copier sur le VPS vers /srv/uba/.env.production
# JAMAIS commiter le vrai fichier (chmod 600).
#
# Generer les secrets :  for k in POSTGRES_PASSWORD REDIS_PASSWORD VAULT_ROOT_TOKEN JWT_SECRET; do echo "$k=$(openssl rand -hex 32)"; done

# --- Postgres ---
POSTGRES_DB=uba
POSTGRES_USER=uba
POSTGRES_PASSWORD=REPLACE_ME

# --- Redis ---
REDIS_PASSWORD=REPLACE_ME

# --- Vault (dev mode pour simplicite - prod passer en raft+unsealing) ---
VAULT_ROOT_TOKEN=REPLACE_ME

# --- Application ---
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ENV=production
DEBUG=false
CORS_ORIGINS=["https://uba.dendani.dz"]
RATE_LIMIT_PER_MINUTE=120

# --- Docker registry (si images prives GHCR) ---
DOCKER_REGISTRY=ghcr.io/dendani
UBA_VERSION=latest

# --- Scaleway Object Storage (backups) ---
SCW_ACCESS_KEY=SCWREPLACEMEXXXXXXXX
SCW_SECRET_KEY=REPLACE_ME
SCW_BUCKET=uba-backups
SCW_ENDPOINT=https://s3.fr-par.scw.cloud
SCW_REGION=fr-par
BACKUP_RETENTION_DAYS=30

# --- Grafana Cloud (metrics remote_write) ---
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-eu-west-X.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=0000000
GRAFANA_CLOUD_API_KEY=glc_REPLACE_ME

# --- Grafana Cloud Loki (optionnel - logs) ---
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=

# --- SonarQube (optionnel) ---
SONAR_TOKEN=

# --- Paths ---
UBA_BACKUP_DIR=/tmp/uba_backups
